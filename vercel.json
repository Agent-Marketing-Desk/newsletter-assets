{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:date(\\d{4}-\\d{2}-\\d{2})", "destination": "/issues/:date.html" }
  ],
  "headers": [
    {
      "source": "/(.*).(png|jpg|jpeg|gif|webp|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
