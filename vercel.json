{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/2026-10-02",
      "destination": "/2026-10-01",
      "permanent": false
    },
    {
      "source": "/issues/2026-10-02",
      "destination": "/issues/2026-10-01",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:date(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/issues/:date"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(png|jpg|jpeg|gif|webp|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
